# ==========================================
# Trade-AI - Git Ignore Configuration
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.p12
*.pfx
*.secret
id_rsa*
*.local

# Node.js & Frontend dependencies
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.wheels/
*.whl

# Python bytecode & caching
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
*.egg-info/
.installed.cfg
*.egg
*.spec

# Temporary scratch & debug scripts
_*.py
debug_*.py

# Logs & Runtime files
*.log
*.log.*
logs/
uvicorn.log*
run_launcher.log

# IDE & Editor artifacts
.vscode/
!.vscode/extensions.json
.idea/
.claude/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Database & local test storage
*.db
*.sqlite
*.sqlite3
