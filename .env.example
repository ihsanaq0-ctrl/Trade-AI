# Trade-AI Frontend Environment Variables
# Copy this file to .env and configure your values

# API backend endpoint (leave blank to use Vite's built-in /api proxy to http://localhost:8002)
VITE_API_BASE_URL=

# Supabase Authentication & Database Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Live Gumroad Pro Plan Checkout URL (free to create at app.gumroad.com)
VITE_GUMROAD_PRO_URL=
